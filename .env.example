# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Postgres connection (Neon via the Vercel Marketplace sets this for you).
# Leave empty locally to use the embedded database in .data/.
DATABASE_URL=

# Team login for the dashboard (user ID and password), and a long random secret (openssl rand -base64 32).
DASHBOARD_USER=
# APP_SECRET also encrypts the saved Shopify credentials: don't change it once stores are added.
DASHBOARD_PASSWORD=
# More people, each with their own login: user:password,user:password
DASHBOARD_EXTRA_USERS=
APP_SECRET=

# Claude API key: reading supplier invoices and quotes, and the Ask page.
ANTHROPIC_API_KEY=

# Currency for the all-stores view. Each store reports in its own Google Ads currency.
BASE_CURRENCY=USD
# Calendar days are counted in this timezone.
REPORT_TIMEZONE=Europe/Copenhagen
INITIAL_SYNC_DAYS=150

# Vercel sends this with cron requests (set any long random string).
CRON_SECRET=


# Shared key that lets AdProfit read order-line cost of goods from /api/export/cogs (any long random string).
COGS_EXPORT_KEY=
